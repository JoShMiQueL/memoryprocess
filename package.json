{
  "name": "memoryprocess",
  "version": "2.0.0-dev.0",
  "description": "Read and write Windows process memory from Node.js / Bun. N-API native addon.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prebuilds",
    "binding.gyp",
    "native"
  ],
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "build:victim": "node scripts/build-victim.mjs",
    "prebuild": "prebuildify --all --napi",
    "lint": "bun lint --type-aware",
    "format": "bun fmt",
    "check": "bun check",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:node": "node --test tests/compat/",
    "prepublishOnly": "npm run build && npm run prebuild"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoShMiQueL/memoryprocess.git"
  },
  "keywords": [
    "memory",
    "process",
    "read",
    "write",
    "windows",
    "native",
    "addon",
    "napi",
    "pattern-scan",
    "game-hacking"
  ],
  "author": "JoShMiQueL",
  "license": "MIT",
  "dependencies": {
    "node-addon-api": "8.3.1",
    "node-gyp-build": "4.8.4"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "node-gyp": "12.4.0",
    "prebuildify": "6.0.1",
    "tsdown": "0.23.3",
    "typescript": "7.0.2"
  },
  "trustedDependencies": [
    "node-gyp-build"
  ]
}
